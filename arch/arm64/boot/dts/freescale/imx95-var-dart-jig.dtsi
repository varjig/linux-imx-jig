#include <dt-bindings/clock/nxp,imx95-clock.h>

/ {
	aliases {
		mmc0 = &usdhc1;
		mmc1 = &usdhc2;
		serial0 = &lpuart1;
		ethernet0 = &enetc_port0;
		ethernet1 = &enetc_port1;
		ethernet2 = &enetc_port2;
	};

	can0_osc: can0_osc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	clk_ov5640_fixed: clock {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};

	panel {
		compatible = "sgd,gktw70sdae4se", "panel-lvds";
		width-mm = <153>;
		height-mm = <87>;
		label = "gktw70sdae4se";
		data-mapping = "jeida-24";
		status = "okay";

		panel-timing {
			clock-frequency = <74250000>;
			hactive = <800>;
			vactive = <480>;
			hback-porch = <40>;
			hfront-porch = <40>;
			vback-porch = <29>;
			vfront-porch = <13>;
			hsync-len = <48>;
			vsync-len = <3>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in: endpoint {
					remote-endpoint = <&lvds0_out>;
				};
			};
		};
	};

	reg_usdhc2_vmmc: regulator-usdhc2 {
		compatible = "regulator-fixed";
		// pinctrl-names = "default";
		// pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
		regulator-name = "VDD_SD2_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	/delete-node/ sound-wm8904;
	/delete-node/ usdhc3_pwrseq;
};

&enetc_port2 {
	phy-mode = "10gbase-r";
	status = "okay";

	fixed-link {
		speed = <10000>;
		full-duplex;
	};
};

&combo_rx {
	status = "okay";
};

&csi_pixel_formatter_0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			formatter_0_in: endpoint {
				remote-endpoint = <&mipi_csi0_out>;
			};
		};

		port@1 {
			reg = <1>;

			formatter_0_out: endpoint {
				remote-endpoint = <&isi_in_2>;
			};
		};
	};
};

&displaymix_irqsteer {
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dphy_rx {
	status = "okay";
};

&dpu {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&ldb0_phy {
	status = "okay";
};

&isi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@2 {
			reg = <2>;

			isi_in_2: endpoint {
				remote-endpoint = <&formatter_0_out>;
			};
		};
	};
};

&mipi_csi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			mipi_csi0_ep: endpoint {
				remote-endpoint = <&ov5640_mipi_0_ep>;
				data-lanes = <1 2>;
				clock-lanes = <0>;
			};
		};

		port@1 {
			reg = <1>;
			mipi_csi0_out: endpoint {
				remote-endpoint = <&formatter_0_in>;
			};
		};
	};
};

&ldb {
	status = "okay";

	channel@0 {
		status = "okay";
		reg = <0>;

		port@1 {
			reg = <1>;
			lvds0_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "gpio", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;
	// pinctrl-1 = <&pinctrl_lpi2c3_gpio>;
	// pinctrl-2 = <&pinctrl_lpi2c3_gpio>;
	scl-gpios = <&gpio2 28 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio2 29 GPIO_ACTIVE_HIGH>;
	status = "okay";

	display_expander: gpio@20 {
		compatible = "nxp,pca9534";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander0: gpio@21 {
		compatible = "nxp,pca9534";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	tpm_expander: gpio@22 {
		compatible = "nxp,pca9534";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	expander1: gpio@24 {
		compatible = "nxp,pca9534";
		reg = <0x24>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander2: gpio@23 {
		compatible = "nxp,pca9534";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;

		usb-sel {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;  // P0 line
			output-high;
			line-name = "USB_SEL";
		};
	};

	ov5640_mipi0: ov5640_mipi0@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		clocks = <&clk_ov5640_fixed>;
		clock-names = "xclk";
		assigned-clock-rates = <24000000>;
		status = "okay";

		port {
			ov5640_mipi_0_ep: endpoint {
				remote-endpoint = <&mipi_csi0_ep>;
				data-lanes = <1 2>;
				clock-lanes = <0>;
			};
		};
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	pinctrl-1 = <&pinctrl_lpi2c4>;
	scl-gpios = <&gpio2 30 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio2 31 GPIO_ACTIVE_HIGH>;
	status = "disabled";
};

&lpi2c8 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c8_gpio>;
	status = "okay";

	/delete-property/ pinctrl-1;
	/delete-property/ pinctrl-2;
	/delete-property/ scl-gpios;
	/delete-property/ sda-gpios;
	/delete-node/ wm8904;
};

&netc_emdio {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_emdio>;
	status = "okay";
};

&enetc_port0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc0>;
	status = "okay";
};

&netc_timer {
	status = "okay";
};

&lpuart1 {
	/* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

// The BT node has deletated in order to enable BT-UART test
&lpuart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	status = "okay";

	/delete-node/ bluetooth;
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_hog: hoggrp {
		fsl,pins = <
			// IMX95_PAD_GPIO_IO32__GPIO5_IO_BIT12		0x31e
			// IMX95_PAD_GPIO_IO25__GPIO2_IO_BIT25		0x31e

			IMX95_PAD_GPIO_IO04__GPIO2_IO_BIT4		0x31e
			IMX95_PAD_PDM_BIT_STREAM1__AONMIX_TOP_GPIO1_IO_BIT10	0x31e

			IMX95_PAD_I2C2_SDA__AONMIX_TOP_GPIO1_IO_BIT3	0x31e
			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_GPIO1_IO_BIT11	0x31e

			IMX95_PAD_GPIO_IO22__GPIO2_IO_BIT22		0x31e
			IMX95_PAD_GPIO_IO05__GPIO2_IO_BIT5		0x31e
			IMX95_PAD_GPIO_IO23__GPIO2_IO_BIT23		0x31e

			IMX95_PAD_DAP_TMS_SWDIO__GPIO3_IO_BIT29		0x31e
			IMX95_PAD_DAP_TCLK_SWCLK__GPIO3_IO_BIT30	0x31e

			IMX95_PAD_XSPI1_DATA5__GPIO5_IO_BIT5	0x31e
			IMX95_PAD_XSPI1_DATA7__GPIO5_IO_BIT7	0x31e

			IMX95_PAD_GPIO_IO12__GPIO2_IO_BIT12		0x31e
			IMX95_PAD_GPIO_IO09__GPIO2_IO_BIT9		0x31e

			IMX95_PAD_XSPI1_DATA6__GPIO5_IO_BIT6	0x31e
			IMX95_PAD_ENET2_RXC__GPIO4_IO_BIT23	0x31e

			IMX95_PAD_XSPI1_DATA4__GPIO5_IO_BIT4	0x3fe
			IMX95_PAD_ENET2_RX_CTL__GPIO4_IO_BIT22	0x31e

			IMX95_PAD_GPIO_IO24__GPIO2_IO_BIT24		0x31e
			IMX95_PAD_PDM_BIT_STREAM0__AONMIX_TOP_GPIO1_IO_BIT9	0x31e

			IMX95_PAD_ENET2_TD1__GPIO4_IO_BIT18		0x31e
			IMX95_PAD_ENET2_TXC__GPIO4_IO_BIT21		0x31e

			IMX95_PAD_ENET2_MDIO__GPIO4_IO_BIT15		0x31e
			IMX95_PAD_ENET2_TD0__GPIO4_IO_BIT19		0x31e

			IMX95_PAD_ENET2_TD2__GPIO4_IO_BIT17		0x31e
			IMX95_PAD_ENET2_TX_CTL__GPIO4_IO_BIT20		0x31e

			IMX95_PAD_ENET2_MDC__GPIO4_IO_BIT14		0x31e
			IMX95_PAD_ENET2_RD0__GPIO4_IO_BIT24		0x31e

			IMX95_PAD_ENET2_RD1__GPIO4_IO_BIT25		0x31e
			IMX95_PAD_CCM_CLKO1__GPIO3_IO_BIT26		0x31e

			IMX95_PAD_ENET2_RD2__GPIO4_IO_BIT26		0x31e
			IMX95_PAD_ENET2_RD3__GPIO4_IO_BIT27		0x31e

			IMX95_PAD_XSPI1_DATA2__GPIO5_IO_BIT2		0x31e
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11		0x31e

			IMX95_PAD_I2C2_SCL__AONMIX_TOP_GPIO1_IO_BIT2	0x31e
			IMX95_PAD_UART2_RXD__AONMIX_TOP_GPIO1_IO_BIT6	0x31e

			IMX95_PAD_DAP_TDI__GPIO3_IO_BIT28		0x31e
			IMX95_PAD_DAP_TDO_TRACESWO__GPIO3_IO_BIT31	0x31e

			IMX95_PAD_UART2_TXD__AONMIX_TOP_GPIO1_IO_BIT7	0x31e
			IMX95_PAD_GPIO_IO19__GPIO2_IO_BIT19		0x31e
			IMX95_PAD_GPIO_IO33__GPIO5_IO_BIT13		0x31e

			IMX95_PAD_WDOG_ANY__AONMIX_TOP_GPIO1_IO_BIT15	0x31e
			IMX95_PAD_PDM_CLK__AONMIX_TOP_GPIO1_IO_BIT8	0x31e

			IMX95_PAD_GPIO_IO15__GPIO2_IO_BIT15		0x31e
			IMX95_PAD_GPIO_IO14__GPIO2_IO_BIT14		0x31e

			IMX95_PAD_GPIO_IO10__GPIO2_IO_BIT10		0x31e
			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_GPIO1_IO_BIT13	0x31e

			IMX95_PAD_SD2_CD_B__GPIO3_IO_BIT0		0x31e
			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7		0x31e

			IMX95_PAD_CCM_CLKO2__GPIO3_IO_BIT27		0x31e
			IMX95_PAD_ENET2_TD3__GPIO4_IO_BIT16		0x31e

			IMX95_PAD_GPIO_IO07__GPIO2_IO_BIT7		0x31e
		>;
	};

	pinctrl_usdhc3_sdex: usdhc3gpiogrp {
		fsl,pins = <
			IMX95_PAD_SD3_CLK__GPIO3_IO_BIT20		0x31e
			IMX95_PAD_SD3_CMD__GPIO3_IO_BIT21		0x31e
			IMX95_PAD_SD3_DATA0__GPIO3_IO_BIT22		0x415
			IMX95_PAD_SD3_DATA1__GPIO3_IO_BIT23		0x415
			IMX95_PAD_SD3_DATA2__GPIO3_IO_BIT24		0x40000b9e
			IMX95_PAD_SD3_DATA3__GPIO3_IO_BIT25		0x40000b9e
		>;
	};

	// To be overlayed by eth0 dtbo
	pinctrl_enetc0: enetc0grp {
		fsl,pins = <
			IMX95_PAD_ENET1_TD3__GPIO4_IO_BIT2		0x31e
			IMX95_PAD_ENET1_TD2__GPIO4_IO_BIT3		0x31e
			IMX95_PAD_ENET1_TD1__GPIO4_IO_BIT4		0x31e
			IMX95_PAD_ENET1_TD0__GPIO4_IO_BIT5		0x31e
			IMX95_PAD_ENET1_TX_CTL__GPIO4_IO_BIT6		0x31e
			IMX95_PAD_ENET1_TXC__GPIO4_IO_BIT7		0x31e
			IMX95_PAD_ENET1_RX_CTL__GPIO4_IO_BIT8		0x31e
			IMX95_PAD_ENET1_RXC__GPIO4_IO_BIT9		0x31e
			IMX95_PAD_ENET1_RD0__GPIO4_IO_BIT10		0x31e
			IMX95_PAD_ENET1_RD1__GPIO4_IO_BIT11		0x31e
			IMX95_PAD_ENET1_RD2__GPIO4_IO_BIT12		0x31e
			IMX95_PAD_ENET1_RD3__GPIO4_IO_BIT13		0x31e
		>;
	};

	// To be overlayed by eth0 dtbo
	pinctrl_emdio: emdiogrp{
		fsl,pins = <
			IMX95_PAD_ENET1_MDC__GPIO4_IO_BIT0		0x31e
			IMX95_PAD_ENET1_MDIO__GPIO4_IO_BIT1		0x31e
		>;
	};

	pinctrl_sai3_gpio: sai3gpiogrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO17__GPIO2_IO_BIT17		0x31e
			IMX95_PAD_GPIO_IO16__GPIO2_IO_BIT16		0x31e
			IMX95_PAD_GPIO_IO26__GPIO2_IO_BIT26		0x31e
			IMX95_PAD_GPIO_IO20__GPIO2_IO_BIT20		0x31e
			IMX95_PAD_GPIO_IO21__GPIO2_IO_BIT21		0x31e
		>;
	};

	pinctrl_lpi2c3: lpi2c3grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO28__LPI2C3_SDA			0x40000b9e
			IMX95_PAD_GPIO_IO29__LPI2C3_SCL			0x40000b9e
		>;
	};

/*
	pinctrl_lpi2c3_gpio: lpi2c3grp-gpio {
		fsl,pins = <
			IMX95_PAD_GPIO_IO28__GPIO2_IO_BIT28		0x31e
			IMX95_PAD_GPIO_IO29__GPIO2_IO_BIT29		0x31e
		>;
	};
*/

	pinctrl_lpi2c4: lpi2c4grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO30__LPI2C4_SDA		0x40000b9e
			IMX95_PAD_GPIO_IO31__LPI2C4_SCL		0x40000b9e
		>;
	};

	pinctrl_rtc: rtcgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO32__GPIO5_IO_BIT12			0x31e
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			IMX95_PAD_UART1_RXD__AONMIX_TOP_LPUART1_RX	0x31e
			IMX95_PAD_UART1_TXD__AONMIX_TOP_LPUART1_TX	0x31e
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__USDHC2_CLK			0x158e
			IMX95_PAD_SD2_CMD__USDHC2_CMD			0x138e
			IMX95_PAD_SD2_DATA0__USDHC2_DATA0		0x138e
			IMX95_PAD_SD2_DATA1__USDHC2_DATA1		0x138e
			IMX95_PAD_SD2_DATA2__USDHC2_DATA2		0x138e
			IMX95_PAD_SD2_DATA3__USDHC2_DATA3		0x138e
			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT		0x51e
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__USDHC2_CLK			0x158e
			IMX95_PAD_SD2_CMD__USDHC2_CMD			0x138e
			IMX95_PAD_SD2_DATA0__USDHC2_DATA0		0x138e
			IMX95_PAD_SD2_DATA1__USDHC2_DATA1		0x138e
			IMX95_PAD_SD2_DATA2__USDHC2_DATA2		0x138e
			IMX95_PAD_SD2_DATA3__USDHC2_DATA3		0x138e
			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT		0x51e
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
		fsl,pins = <
			IMX95_PAD_SD2_CLK__USDHC2_CLK			0x15fe
			IMX95_PAD_SD2_CMD__USDHC2_CMD			0x13fe
			IMX95_PAD_SD2_DATA0__USDHC2_DATA0		0x13fe
			IMX95_PAD_SD2_DATA1__USDHC2_DATA1		0x13fe
			IMX95_PAD_SD2_DATA2__USDHC2_DATA2		0x13fe
			IMX95_PAD_SD2_DATA3__USDHC2_DATA3		0x13fe
			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT		0x51e
		>;
	};

	// 0x1fe - *No pull up*!, Fast Slew Rate, Drive Strength Field - X6.
	pinctrl_uart5: uart5grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO00__LPUART5_TX					0x1fe
			IMX95_PAD_GPIO_IO01__LPUART5_RX					0x1fe
			IMX95_PAD_GPIO_IO02__LPUART5_CTS_B				0x1fe
			IMX95_PAD_GPIO_IO03__LPUART5_RTS_B				0x1fe
		>;
	};

	pinctrl_lpi2c8_gpio: lpi2c8grp-gpio {
		fsl,pins = <
			IMX95_PAD_GPIO_IO10__GPIO2_IO_BIT10				0x31e
			IMX95_PAD_GPIO_IO11__GPIO2_IO_BIT11				0x31e
		>;
	};
};

&sai3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sai3_gpio>;
	status = "okay";
};

&usb2 {
	dr_mode = "host";
	hnp-disable;
	srp-disable;
	adp-disable;
	disable-over-current;
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default","state_100mhz","state_200mhz","sleep";
	pinctrl-0 = <&pinctrl_usdhc2>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
	fsl,cd-gpio-wakeup-disable;
	broken-cd;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	status = "okay";
};

&usdhc3 {
	/delete-property/ mmc-pwrseq;
	status = "disabled";
};
