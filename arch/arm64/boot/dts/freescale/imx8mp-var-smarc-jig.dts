#include "imx8mp-var-smarc.dtsi"

/ {
	model = "Variscite VAR-SMARC-MX8M-PLUS on JIG";

	chosen {
		stdout-path = &uart2;
	};

	reg_usdhc2_vmmc: regulator-usdhc2-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "VSD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&carrier_gpio 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	panel {
		compatible = "sgd,gktw70sdae4se", "panel-lvds";
		width-mm = <153>;
		height-mm = <87>;
		label = "gktw70sdae4se";
		data-mapping = "vesa-24";
		status = "okay";

		panel-timing {
			clock-frequency = <66000000>;
			hactive = <1600>;
			vactive = <480>;
			hback-porch = <80>;
			hfront-porch = <80>;
			vback-porch = <29>;
			vfront-porch = <13>;
			hsync-len = <96>;
			vsync-len = <3>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&lvds_out>;
			};
		};
	};

	display-subsystem {
		ports = <&lcdif2_disp>,
			<&lcdif1_disp>,
			<&lcdif3_disp>;
	};
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lvds_rgb_gpio>;

	pinctrl_lvds_rgb_gpio: lvdsrgbgpiogrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO05__GPIO1_IO05				0x116
			MX8MP_IOMUXC_GPIO1_IO14__GPIO1_IO14				0x116
			MX8MP_IOMUXC_GPIO1_IO03__GPIO1_IO03				0x116
			MX8MP_IOMUXC_GPIO1_IO00__GPIO1_IO00				0x116
			MX8MP_IOMUXC_SAI1_RXD0__GPIO4_IO02				0x116
			MX8MP_IOMUXC_GPIO1_IO01__GPIO1_IO01				0x116
			MX8MP_IOMUXC_GPIO1_IO07__GPIO1_IO07				0x116
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06				0x116
			MX8MP_IOMUXC_SD1_DATA7__GPIO2_IO09				0x116
			MX8MP_IOMUXC_UART1_TXD__GPIO5_IO23				0x116
			MX8MP_IOMUXC_GPIO1_IO11__GPIO1_IO11				0x116
			MX8MP_IOMUXC_SAI2_RXFS__GPIO4_IO21				0x116
			MX8MP_IOMUXC_SD1_DATA6__GPIO2_IO08				0x116
			MX8MP_IOMUXC_UART1_RXD__GPIO5_IO22				0x116
			MX8MP_IOMUXC_UART3_RXD__GPIO5_IO26				0x116
			MX8MP_IOMUXC_UART3_TXD__GPIO5_IO27				0x116
			MX8MP_IOMUXC_ECSPI1_SCLK__GPIO5_IO06				0x3
			MX8MP_IOMUXC_ECSPI1_MISO__GPIO5_IO08				0x3
			MX8MP_IOMUXC_SAI1_TXD6__GPIO4_IO18				0x116
			MX8MP_IOMUXC_SAI1_RXFS__GPIO4_IO00				0x116
			MX8MP_IOMUXC_UART4_TXD__GPIO5_IO29				0x116
			MX8MP_IOMUXC_UART4_RXD__GPIO5_IO28				0x116
			MX8MP_IOMUXC_ECSPI1_MOSI__GPIO5_IO07				0x3
			MX8MP_IOMUXC_ECSPI1_SS0__GPIO5_IO09				0x3
		>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <
			MX8MP_IOMUXC_UART2_RXD__UART2_DCE_RX				0x40
			MX8MP_IOMUXC_UART2_TXD__UART2_DCE_TX				0x40
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK				0x190
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD				0x1d0
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0				0x1d0
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1				0x1d0
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2				0x1d0
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3				0x1d0
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2grp-100mhz {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK				0x194
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD				0x1d4
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0				0x1d4
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1				0x1d4
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2				0x1d4
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3				0x1d4
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2grp-200mhz {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK				0x196
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD				0x1d6
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0				0x1d6
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1				0x1d6
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2				0x1d6
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3				0x1d6
		>;
	};
};

&i2c4 {
	carrier_gpio: gpio@20 {
		compatible = "nxp,pcal6416";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"ETH_TEST_SEL",
			"AUD_TEST_SEL",
			"SD_PWR_EN",
			"USB_HUB1_RSTN",
			"USB_HUB2_RSTN",
			"USB_TEST1_SEL",
			"USB_TEST2_SEL",
			"BTPCM_TEST_SEL",
			"HDMI_2RGB_EN",
			"RGB_LTCH_OE",
			"LVDS_SW2_SEL",
			"LVDS_SW1_SEL",
			"DSI_2LVDS_EN",
			"DSI_SW_SEL",
			"PMIC_STBY_REQ_B",
			"CARRIER_PWR_ON";
		status = "okay";

		usb-hub1-rstn-hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "USB_HUB1_RSTN";
		};

		usb-hub2-rstn-hog {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "USB_HUB2_RSTN";
		};
	};

	dsi_lvds_bridge: sn65dsi84@2c {
		compatible = "ti,sn65dsi83";
		reg = <0x2c>;
		ti,dsi-lanes = <4>;
		ti,lvds-format = <1>;
		ti,lvds-bpp = <24>;
		ti,lvds-channels = <1>;
		ti,width-mm = <154>;
		ti,height-mm = <87>;
		enable-gpios = <&carrier_gpio 12 GPIO_ACTIVE_HIGH>;
		status = "okay";

		display-timings {
			lvds {
				clock-frequency = <33000000>;
				hactive = <800>;
				vactive = <480>;
				hback-porch = <40>;
				hfront-porch = <40>;
				vback-porch = <29>;
				vfront-porch = <13>;
				hsync-len = <48>;
				vsync-len = <3>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <0>;
			};
		};

		port {
			dsi_lvds_bridge_in: endpoint {
				remote-endpoint = <&mipi_dsi_out>;
			};
		};
	};
};

&irqsteer_hdmi {
	status = "okay";
};

&hdmimix_clk {
	status = "okay";
};

&hdmimix_reset {
	status = "okay";
};

&hdmi_pavi {
	status = "okay";
};

&hdmi {
	status = "okay";
};

&hdmiphy {
	status = "okay";
};

/* MIPI-DSI */
&lcdif1 {
	status = "okay";
};

/* LVDS */
&lcdif2 {
	status = "okay";
};

/* HDMI */
&lcdif3 {
	status = "okay";
};

&ldb {
	status = "okay";
	fsl,dual-channel;

	lvds-channel@0 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&ldb_phy {
	status = "okay";
};

&mipi_dsi {
	status = "okay";

	port@1 {
		reg = <1>;

		mipi_dsi_out: endpoint {
			remote-endpoint = <&dsi_lvds_bridge_in>;
			attach-bridge;
		};
	};
};

&snvs_pwrkey {
	status = "disabled";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	status = "okay";
};

&uart3 {
	status = "disabled";
};

&usb3_phy0 {
	status = "okay";
};

&usb3_0 {
	status = "okay";
};

&usb_dwc3_0 {
	dr_mode = "host";
	hnp-disable;
	srp-disable;
	adp-disable;
	status = "okay";
};

&usb3_phy1 {
	status = "okay";
};

&usb3_1 {
	status = "okay";
};

&usb_dwc3_1 {
	dr_mode = "host";
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc2>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
	non-removable;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	no-1-8-v;
	status = "okay";
};

&wdog1 {
	status = "disabled";
};
